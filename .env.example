# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# CORS allowed origins (comma-separated list, e.g. https://waba.yourdomain.com)
ALLOWED_ORIGINS=http://localhost:5173,https://waba.yourdomain.com

# ─── Database Configuration (MySQL) ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=wa_dashboard

# ─── JWT Configuration ─────────────────────────────────────────────────────────
# Change this to a very secure random string in production
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# ─── Meta WhatsApp Cloud API Configuration ─────────────────────────────────────
# Access token from developers.facebook.com
ACCESS_TOKEN=your_meta_access_token_here

# Numeric Phone Number ID
PHONE_NUMBER_ID=your_phone_number_id_here

# WABA ID
BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here

# App ID & Secret from basic settings
APP_ID=your_meta_app_id_here
APP_SECRET=your_meta_app_secret_here

# Verification Token for incoming webhooks verification
WEBHOOK_VERIFY_TOKEN=your_verify_token_here
