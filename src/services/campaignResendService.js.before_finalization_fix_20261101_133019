import { pool } from '../config/db.js';
import { sendCentralTemplateMessage } from './templateMessageSenderService.js';
import { emitToOrganization } from '../utils/socket.js';
import logger from '../utils/logger.js';

const wait = ms => new Promise(resolve => setTimeout(resolve, ms));
const json = (value, fallback) => {
  if (!value) return fallback;
  if (typeof value === 'object') return value;
  try { return JSON.parse(value); } catch { return fallback; }
};

export async function processResendJob(jobId) {
  // Atomic job claim: only one worker can start a queued resend job.
  const [claim] = await pool.query(
    "UPDATE campaign_resend_jobs SET status='running', started_at=COALESCE(started_at,NOW()) WHERE id=? AND status='queued'",
    [jobId]
  );

  if (claim.affectedRows !== 1) {
    logger.warn(`[CampaignResend] Job ${jobId} already claimed or not queued; execution skipped.`);
    return;
  }

  const [[job]] = await pool.query(
    'SELECT * FROM campaign_resend_jobs WHERE id=?',
    [jobId]
  );
  if (!job) return;
  const [[campaign]] = await pool.query('SELECT * FROM campaigns WHERE id=?', [job.campaign_id]);
  if (!campaign) return pool.query("UPDATE campaign_resend_jobs SET status='failed',error_message='Campaign not found',finished_at=NOW() WHERE id=?", [jobId]);
  const [recipients] = await pool.query('SELECT * FROM campaign_recipients WHERE resend_job_id=? ORDER BY id', [jobId]);
  const args = {
    templateName: campaign.template_name,
    languageCode: campaign.language_code || 'en_US',
    components: json(campaign.components_json, []),
    variables: json(campaign.variables_json, {}),
    customMediaUrl: campaign.custom_media_url,
    customCarouselMedia: json(campaign.carousel_media_json, null),
    campaignId: campaign.id,
    campaignName: campaign.campaign_name,
    campaignType: 'resend', featureKey: 'general', userId: campaign.user_id || 1,
    organizationId: campaign.organization_id, accountId: campaign.whatsapp_account_id
  };
  for (const recipient of recipients) {
    // Claim only queued recipients. Never replay an already processed attempt.
    const [claim] = await pool.query(
      "UPDATE campaign_recipients SET status='sending' WHERE id=? AND resend_job_id=? AND status='queued'",
      [recipient.id, jobId]
    );

    if (claim.affectedRows !== 1) continue;

    const result = await sendCentralTemplateMessage({ ...args, recipient: recipient.phone });
    if (result.success) {
      await pool.query(
        `UPDATE campaign_recipients
         SET message_id=?,
             status=CASE
               WHEN LOWER(status) IN ('delivered','read') THEN status
               ELSE 'sent'
             END,
             error=NULL,
             sent_at=NOW()
         WHERE id=? AND resend_job_id=?`,
        [result.messageId, recipient.id, jobId]
      );
      await pool.query('UPDATE campaign_resend_jobs SET sent_count=sent_count+1 WHERE id=?', [jobId]);
    } else {
      const code = result.details?.code || result.details?.error?.code || null;
      const message = `${code ? `Meta Error ${code}: ` : ''}${result.message || 'Message send failed'}`;
      const status = result.uncertain ? 'uncertain' : 'failed';

      await pool.query(
        "UPDATE campaign_recipients SET status=?,error=? WHERE id=? AND resend_job_id=?",
        [status, message, recipient.id, jobId]
      );

      if (!result.uncertain) {
        await pool.query(
          'UPDATE campaign_resend_jobs SET failed_count=failed_count+1 WHERE id=?',
          [jobId]
        );
      }

      if (result.uncertain) {
        logger.warn(`[CampaignResend] Unknown Meta outcome: job=${jobId}, recipient=${recipient.id}. Automatic retry disabled.`);
      }
    }
    emitToOrganization(campaign.organization_id || 1, 'campaign_resend_updated', { campaignId: campaign.id, jobId });
    await wait(Number(process.env.CAMPAIGN_RESEND_DELAY_MS || 300));
  }
  await pool.query("UPDATE campaign_resend_jobs SET status='awaiting_webhooks' WHERE id=?", [jobId]);
  emitToOrganization(campaign.organization_id || 1, 'campaign_resend_updated', { campaignId: campaign.id, jobId, awaitingWebhooks: true });
}

// Called at startup only. Preserve recipients for manual reconciliation.
export async function markStaleResendJobs() {
  const [result] = await pool.query(
    `UPDATE campaign_resend_jobs
     SET status='interrupted',
         error_message='Worker stopped before completion; reconcile before retry',
         finished_at=NOW()
     WHERE status='running'`
  );
  if (result.affectedRows) {
    logger.warn(`[CampaignResend] Marked ${result.affectedRows} old running job(s) interrupted`);
  }
}

export function startResendJob(jobId) {
  setImmediate(() => processResendJob(jobId).catch(async err => {
    logger.error(`[CampaignResend] Job ${jobId} failed: ${err.message}`);
    await pool.query(
      "UPDATE campaign_resend_jobs SET status='interrupted',error_message=?,finished_at=NOW() WHERE id=? AND status='running'",
      [err.message, jobId]
    ).catch(() => {});
  }));
}
